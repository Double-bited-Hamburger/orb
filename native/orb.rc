#include <winver.h>
#include "version.h"

1 ICON "orb.ico"
1 24 "orb.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     ORB_VERSION_NUM
PRODUCTVERSION  ORB_VERSION_NUM
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  "Orb - animated orb + liquid glass clock"
      VALUE "FileVersion",      ORB_VERSION_STR
      VALUE "ProductName",      "Orb"
      VALUE "ProductVersion",   ORB_VERSION_STR
      VALUE "OriginalFilename", "Orb.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
